<Window x:Class="ComputerUseWpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computer Use WPF Demo"
        Width="800"
        Height="500"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F4F4F4">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="360">
            <TextBlock x:Name="StatusText"
                       Text="Ready"
                       FontSize="32"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28" />

            <Button x:Name="ActionButton"
                    Content="CLICK ME"
                    Width="300"
                    Height="100"
                    FontSize="30"
                    FontWeight="Bold"
                    Click="ActionButton_Click"
                    AutomationProperties.Name="Computer Use Test Button"
                    AutomationProperties.AutomationId="ActionButton" />

            <TextBlock Text="Computer Use test target"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       Margin="0,22,0,0" />
        </StackPanel>
    </Grid>
</Window>
